# ══════════════════════════════════════
# Arkhos — Variables de entorno
# Copia este archivo como .env.local y rellena los valores
# ══════════════════════════════════════

# ─── Supabase ─────────────────────────
# URL del proyecto (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública anon (Settings > API > anon/public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio — SOLO backend, nunca exponer al cliente
# (Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=

# ─── App ──────────────────────────────
# URL pública de la app (para redirects de auth, emails, etc.)
NEXT_PUBLIC_SITE_URL=https://arkhos.pelayodelafuente.es

# ─── Anthropic (módulo Mercados) ──────
# API key de Anthropic para análisis IA
ANTHROPIC_API_KEY=

# ─── Upstash Redis (cache de APIs) ────
# REST URL y token del proyecto Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Módulo Mercados — APIs financieras ──
# CoinGecko (crypto): https://www.coingecko.com/en/api — plan Demo gratuito
# Con plan Pro añadir aquí; con plan gratuito no es necesaria (endpoint público)
COINGECKO_API_KEY=

# Alpha Vantage (acciones, ETFs, forex, índices): https://www.alphavantage.co/support/#api-key
# Plan gratuito: 25 req/día. TTL cache recomendado: 5 minutos.
ALPHA_VANTAGE_API_KEY=

# ExchangeRate-API (tipos de cambio): https://app.exchangerate-api.com/keys
# Plan gratuito: 1.500 req/mes. TTL cache recomendado: 1 hora.
EXCHANGERATE_API_KEY=

# FRED API (datos macro — BCE/Fed, inflación): https://fred.stlouisfed.org/docs/api/api_key.html
# Gratuita. TTL cache recomendado: 24 horas.
FRED_API_KEY=

# ─── APIs adicionales Mercados ────────
# Finnhub (acciones en tiempo real): https://finnhub.io/register — Free tier: 60 req/min
FINNHUB_API_KEY=

# Etherscan (balances ETH on-chain): https://etherscan.io/apis — Free tier disponible
ETHERSCAN_API_KEY=

# ─── Sentry (monitorización) ──────────
# DSN del proyecto Sentry para error tracking
SENTRY_DSN=
