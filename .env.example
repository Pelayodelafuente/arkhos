# ══════════════════════════════════════
# Arkhos — Variables de entorno
# Copia este archivo como .env.local y rellena los valores
# ══════════════════════════════════════

# ─── Supabase ─────────────────────────
# URL del proyecto (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública anon (Settings > API > anon/public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio — SOLO backend, nunca exponer al cliente
# (Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=

# ─── App ──────────────────────────────
# URL pública de la app (para redirects de auth, emails, etc.)
NEXT_PUBLIC_SITE_URL=https://arkhos.pelayodelafuente.es

# ─── Anthropic (módulo Mercados) ──────
# API key de Anthropic para análisis IA
ANTHROPIC_API_KEY=

# ─── Upstash Redis (cache de APIs) ────
# REST URL y token del proyecto Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Sentry (monitorización) ──────────
# DSN del proyecto Sentry para error tracking
SENTRY_DSN=
